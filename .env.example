PORT=4100
HOST=127.0.0.1
DATA_FILE=./data/social-pulse.sqlite
BUSINESS_TIME_ZONE=Africa/Cairo
ALERT_GRACE_MINUTES=15
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TOKEN_ENCRYPTION_KEY=

# Organic Facebook Page + linked Instagram Professional account.
# Existing ad token works only if it also has Page/Instagram read permissions.
META_ACCESS_TOKEN=
META_API_VERSION=v24.0
META_PAGE_IDS=

# TikTok Display API user OAuth token with video.list scope (not Marketing/Ads token).
TIKTOK_DISPLAY_ACCESS_TOKEN=
TIKTOK_DISPLAY_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/oauth/tiktok/callback

# Snapchat Public Profile API allowlisted OAuth app with snapchat-profile-api scope.
SNAP_PROFILE_ACCESS_TOKEN=
SNAP_PROFILE_ID=
SNAP_PROFILE_REFRESH_TOKEN=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=

# GA4 Data API; Google Ads OAuth scope alone cannot read Analytics.
GA4_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# Post designer image backgrounds (server only). Defaults to gpt-image-1.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Odoo 19+ JSON-2, read-only schedule. Use a dedicated API key with calendar/event read access.
ODOO_URL=
ODOO_DATABASE=
ODOO_API_KEY=
# For Odoo 18 or older, set mode to jsonrpc and provide a read-only username.
ODOO_API_MODE=json2
ODOO_USERNAME=
# Optional custom course model and its date fields.
ODOO_COURSE_MODEL=
ODOO_COURSE_START_FIELD=date_begin
ODOO_COURSE_END_FIELD=date_end
