PORT=4100
HOST=127.0.0.1
DATA_FILE=./data/social-pulse.sqlite
BUSINESS_TIME_ZONE=Africa/Cairo
ALERT_GRACE_MINUTES=15
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TOKEN_ENCRYPTION_KEY=

# Organic Facebook Page + linked Instagram Professional account.
# Existing ad token works only if it also has Page/Instagram read permissions.
META_ACCESS_TOKEN=
META_API_VERSION=v24.0
META_PAGE_IDS=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-domain.example/api/oauth/facebook/callback
META_INSTAGRAM_REDIRECT_URI=https://your-domain.example/api/oauth/instagram/callback
# Optional Facebook Login for Business user-token configurations. Keep read and publishing permission sets separate.
META_READ_LOGIN_CONFIG_ID=
META_PUBLISH_LOGIN_CONFIG_ID=

# TikTok Display API user OAuth token with video.list scope (not Marketing/Ads token).
TIKTOK_DISPLAY_ACCESS_TOKEN=
TIKTOK_DISPLAY_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/oauth/tiktok/callback

# Snapchat Public Profile API allowlisted OAuth app with snapchat-profile-api scope.
SNAP_PROFILE_ACCESS_TOKEN=
SNAP_PROFILE_ID=
SNAP_PROFILE_REFRESH_TOKEN=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
SNAP_REDIRECT_URI=https://your-domain.example/api/oauth/snapchat/callback

# TikTok publishing is separately authorized; leave these false until the relevant access is verified.
TIKTOK_DIRECT_POST_APPROVED=false
TIKTOK_SANDBOX_POSTING=false
# Set only after verifying this exact origin in TikTok URL properties (required for photos).
TIKTOK_VERIFIED_MEDIA_ORIGINS=

# Dedicated owner OAuth; API keys cannot authorize uploads or Analytics reports.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://your-domain.example/api/oauth/youtube/callback

# GA4 Data API; Google Ads OAuth scope alone cannot read Analytics.
GA4_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REFRESH_TOKEN=

# Full-creative image model (server only). Default gpt-image-2.5-flare; see docs/MODEL_COMPARISON.md.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_TEXT_MODEL=gpt-4.1-mini
# Designs SVG templates in the Library (one call per template, a few cents).
OPENAI_TEMPLATE_MODEL=gpt-5
# Optional: writes the content kits beside each post (defaults to OPENAI_CREATIVE_TEXT_MODEL, then gpt-5.5).
# OPENAI_CONTENT_MODEL=
# Optional: live trend search with OpenAI web search (defaults to OPENAI_CONTENT_MODEL).
# OPENAI_TREND_MODEL=
# Optional: plans Studio AI edits and checks their results (defaults to OPENAI_VISION_MODEL, then gpt-5.5).
# OPENAI_EDIT_MODEL=

# Odoo 19+ JSON-2, read-only schedule. Use a dedicated API key with calendar/event read access.
ODOO_URL=
ODOO_DATABASE=
ODOO_API_KEY=
# For Odoo 18 or older, set mode to jsonrpc and provide a read-only username.
ODOO_API_MODE=json2
ODOO_USERNAME=
ODOO_INCLUDE_CALENDAR_EVENTS=false
# Optional custom course model and its date fields.
ODOO_COURSE_MODEL=
ODOO_COURSE_START_FIELD=date_begin
ODOO_COURSE_END_FIELD=date_end

# First admin, created on start when no user exists. Use a strong password (10+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Generated images, uploads and Studio layers. Defaults to the folder of DATA_FILE (the Railway volume).
MEDIA_DIR=

# Public address used in notification emails.
APP_URL=https://web-production-d07de.up.railway.app

# Notification email (new posts from any department). Gmail: smtp.gmail.com, port 465, and an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
